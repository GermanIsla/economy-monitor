# ============================================================
# Economy Monitor — .gitignore
# ============================================================
mejoras.txt
notas.txt
# ------------------------------------------
# Secretos y configuración sensible
# ------------------------------------------
.env
.env.*
!.env.example        # Sí se sube la plantilla de ejemplo (sin valores reales)
*.secret
secrets/
credentials/

# ------------------------------------------
# Base de datos (datos locales, no se suben)
# ------------------------------------------
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ------------------------------------------
# Archivos de staging (datos crudos descargados)
# ------------------------------------------
data/staging/
staging/

# ------------------------------------------
# Logs
# ------------------------------------------
logs/
*.log

# ------------------------------------------
# Entorno virtual Python
# ------------------------------------------
venv/
.venv/
env/
ENV/
.env/

# ------------------------------------------
# Caché Python
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------
# Distribución y empaquetado
# ------------------------------------------
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ------------------------------------------
# Jupyter Notebooks (checkpoints)
# ------------------------------------------
.ipynb_checkpoints/
*.ipynb

# ------------------------------------------
# IDEs y editores
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------------------------------------------
# Alembic — versiones de migración generadas localmente
# (se suben las migraciones, pero no los artefactos de runtime)
# ------------------------------------------
# db/migrations/versions/ → SÍ se sube (son scripts versionados)

# ------------------------------------------
# Archivos temporales y del sistema
# ------------------------------------------
*.tmp
*.bak
*.orig
*.pyc
.coverage
htmlcov/
coverage.xml

# ------------------------------------------
# APScheduler — jobstore SQLite del scheduler
# ------------------------------------------
scheduler.db
apscheduler.db

# ------------------------------------------
# Claves API, tokens y certificados
# ------------------------------------------
*.pem
*.key
*.crt
*.p12
api_keys.txt
tokens.txt